{
	"name": "virtual-list",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint --cache app/**/*.{ts,tsx}",
		"prettify": "prettier --log-level warn --cache --write \"app/**/*.{ts,tsx,js,json,yml,scss}\"",
		"lint-staged": "lint-staged",
		"prepare": "husky"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"next": "16.4.3",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@typescript-eslint/parser": "^8.73.0",
		"eslint": "^9",
		"eslint-config-next": "16.4.3",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.18.1",
		"husky": "^9.1.7",
		"prettier": "^3.10.1",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,scss,md}": [
			"prettier --write"
		]
	}
}
